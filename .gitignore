# Repo-root ignores (package-level ignores live in skillcorpus/.gitignore)
__pycache__/
*.pyc
.pytest_cache/
# Ruff writes this wherever it is invoked from, including inside
# skillcorpus_plugin/ — where the project-inventory gate scans directories and
# fails on it as an undocumented package.
.ruff_cache/
*.egg-info/
build/
dist/
!skillcorpus_plugin/plugin-workbuddy/dist/
!skillcorpus_plugin/plugin-workbuddy/dist/hook.mjs

# top-level inputs/artifacts (private / generated)
configs/sources.full.yaml
audit/source_license_report.csv
audit/source_manifest.csv
