{
  "name": "@evermind-ai/workbuddy-skillsearch",
  "version": "0.2.0",
  "description": "Skill retrieval for WorkBuddy: a UserPromptSubmit hook over the skillsearch engine.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    ".codebuddy-plugin",
    "hooks",
    "README.md",
    "LICENSE",
    "mcp"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "esbuild src/hook.ts --bundle --format=esm --platform=node --packages=external --outfile=dist/hook.mjs && esbuild src/mcp.ts --bundle --format=esm --platform=node --packages=external --outfile=dist/mcp.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "ci": "npm run typecheck && npm run test && npm run build",
    "prepack": "npm run clean && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EverMind-AI/SkillCorpus.git",
    "directory": "skillcorpus_plugin/plugin-workbuddy"
  },
  "homepage": "https://github.com/EverMind-AI/SkillCorpus/tree/main/skillcorpus_plugin/plugin-workbuddy",
  "bugs": {
    "url": "https://github.com/EverMind-AI/SkillCorpus/issues"
  }
}
