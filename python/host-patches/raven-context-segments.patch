+def skills_config_from_host(config: "RavenConfig", *, model: str | None = None) -> dict:
+    """Translate the host's ``skillForge`` block into the plugin's slice.
+
+    Skill retrieval used to be assembled by the host from
+    ``config.skill_forge``; it is now a plugin reading
+    ``plugins.config["skills-retrieval"]``. Without this bridge every
+    existing deployment would silently fall back to plugin defaults on
+    upgrade — no gate, no Hub, default weights — so the old keys keep
+    working and an explicit plugin slice simply wins over them.
+
+    ``model`` is the agent's model, used as the gate's when the old
+    ``llm_gate_model`` was left unset. That mirrors the previous
+    behaviour, where the gate shared the host's provider.
+    """
+    sf = config.skill_forge
+    router = sf.router
+    hub = router.hub
+    weights = router.weights or {}
+
+    # An empty gate model means "no gate" to the plugin, so only fill one
+    # in when the old config actually wanted a gate.
+    gate_model = sf.llm_gate_model or (model if sf.llm_gate_enabled else None)
+
+    return {
+        "skills_dir": "skills",
+        "builtin_dir": "",
+        "extra_dirs": list(sf.local_dirs or []),
+        "scan_depth": sf.scan_max_depth,
+        "hub_endpoint": hub.endpoint or "",
+        "hub_api_key": hub.api_key or "",
+        "hub_timeout_s": hub.timeout_s,
+        "hub_min_safety": hub.min_safety,
+        "weight_local": weights.get("local", 1.0),
+        "weight_hub": weights.get("hub", 0.85),
+        "weight_memory": weights.get("everos", 0.9),
+        "over_fetch": router.over_fetch_factor,
+        "dedup_by": router.dedup_by,
+        "top_k": router.top_k,
+        "model": gate_model or "",
+        "gate": sf.llm_gate_enabled,
+        "rewrite": sf.rewrite_enabled,
+        "gate_pool": sf.llm_gate_pool_size,
+        "max_select": sf.llm_gate_max_select,
+        "agent_id": config.memory.agent_id,
+    }
+
+
+def build_plugin_segments(
+    workspace: Path,
+    config: "RavenConfig",
+    *,
+    registry: PluginRegistry | None = None,
+    get_tool_definitions: "Callable[[], list[dict]] | None" = None,
+    model: str | None = None,
+    backend: "MemoryBackend | None" = None,
+) -> dict:
+    """Construct every plugin-contributed context segment.
+
+    Same shape as :func:`build_plugin_tools`, keyed the way the host wants
+    it: each entry maps the built-in stage the segment ``replaces`` to the
+    builder itself, which is what ``build_context_engine`` consumes. A
+    segment replacing nothing is keyed by its own name and appends after
+    the built-in stages.
+
+    ``get_tool_definitions`` is the one host service a segment may take —
+    the skill-retrieval gate uses it to drop skills whose workflow needs a
+    tool the agent lacks. Pass the agent's
+    ``ToolRegistry.get_definitions``: a callable, not a snapshot, because
+    the tool set is only complete once plugin tools are registered too.
+
+    Lenient like the tool path — a factory that raises is logged and
+    skipped, one returning ``None`` declines quietly, so neither keeps the
+    agent from booting.
+    """
+    if registry is None:
+        registry = build_plugin_registry(config)
+    names = registry.context_segment_names()
+    if not names:
+        return {}
+    services = ServiceLocator(
+        workspace=workspace,
+        user_id=config.memory.user_id,
+        agent_id=config.memory.agent_id,
+        get_tool_definitions=get_tool_definitions,
+    )
+    slices = config.plugins.config
+    segments: dict = {}
+    for name in names:
+        plugin_id = registry.context_segment_plugin_id(name)
+        plugin_slice = (plugin_id and slices.get(plugin_id)) or slices.get(name) or {}
+        if plugin_id == "skillsearch":
+            # Old skillForge keys underneath, explicit plugin config on top.
+            plugin_slice = {
+                **skills_config_from_host(config, model=model),
+                **plugin_slice,
+                # Not user-settable: the live backend object the everos
+                # source recalls through.
+                "_memory": backend,
+            }
+        try:
+            segment = registry.build_context_segment(
+                name,
+                config=plugin_slice,
+                services=services,
+            )
+        except Exception as e:
+            logger.warning(
+                "plugin context segment %r factory raised at construction (%s); skipping it.",
+                name,
+                e,
+            )
+            continue
+        if segment is None:
+            logger.debug(
+                "plugin context segment %r factory opted out (returned None); skipping it.",
+                name,
+            )
+            continue
+        segments[registry.context_segment_replaces(name) or name] = segment
+    return segments
+
