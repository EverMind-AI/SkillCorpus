{
  "name": "@evermind-ai/workbuddy-skillsearch",
  "version": "0.1.0",
  "description": "Skill retrieval for WorkBuddy: a UserPromptSubmit hook over the skillsearch engine.",
  "license": "Apache-2.0",
  "type": "module",
  "files": [
    "dist",
    ".codebuddy-plugin",
    "hooks",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "esbuild src/hook.ts --bundle --format=esm --platform=node --packages=external --outfile=dist/hook.mjs",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --import tsx --test \"test/*.test.ts\"",
    "ci": "npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
